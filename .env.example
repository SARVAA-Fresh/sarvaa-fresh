# ───────────────────────────────────────────────
# SARVAA Fresh — Environment Variables
# ───────────────────────────────────────────────

# Copy this file to .env and fill in real values

# ─── Database ──────────────────────────────────
DATABASE_URL="postgresql://sarvaa:sarvaa_dev_pass@localhost:5432/sarvaa_fresh?schema=public"

POSTGRES_USER=sarvaa
POSTGRES_PASSWORD=sarvaa_dev_pass
POSTGRES_DB=sarvaa_fresh

# ─── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication ────────────────────────────
JWT_SECRET=change-me-to-a-256-bit-random-secret-key
JWT_EXPIRES_IN=7d

# ─── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# ─── File Storage (AWS S3 / Cloudflare R2) ─────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET_NAME=sarvaa-uploads
# AWS_S3_ENDPOINT=

# ─── Frontend URL ──────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Logging ───────────────────────────────────
LOG_LEVEL=debug
