# SARVAA Fresh production container environment
# Copy this file to .env.production for local production testing.
# Before deploying publicly, replace every "change-me" value and set the public
# frontend/API URLs to your real domains.

POSTGRES_USER=sarvaa
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=sarvaa_fresh

# Internal Docker service URLs. Keep postgres and redis hostnames for Compose.
DATABASE_URL=postgresql://sarvaa:replace-with-strong-postgres-password@postgres:5432/sarvaa_fresh?schema=public
REDIS_URL=redis://redis:6379

# MUST replace before any non-local deployment.
JWT_SECRET=replace-with-strong-random-jwt-secret
ADMIN_JWT_SECRET=replace-with-strong-admin-jwt-secret
JWT_EXPIRES_IN=7d

NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Replace these with your real public URLs before deployment.
FRONTEND_URL=https://your-domain.example
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example/api/v1
BACKEND_PORT=3001
FRONTEND_PORT=3000

UPLOAD_LOCAL_PATH=/app/uploads
UPLOAD_LOCAL_URL_PREFIX=/uploads

LOG_LEVEL=info
