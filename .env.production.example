# SARVAA Fresh production container environment
# Copy this file to .env.production for local production testing.
# Before deploying publicly, replace every "change-me" value and set the public
# frontend/API URLs to your real domains.

POSTGRES_USER=sarvaa
POSTGRES_PASSWORD=sarvaa_dev_pass
POSTGRES_DB=sarvaa_fresh

# Internal Docker service URLs. Keep postgres and redis hostnames for Compose.
DATABASE_URL=postgresql://sarvaa:sarvaa_dev_pass@postgres:5432/sarvaa_fresh?schema=public
REDIS_URL=redis://redis:6379

# MUST replace before any non-local deployment.
JWT_SECRET=change-me-to-a-256-bit-random-secret-key
JWT_EXPIRES_IN=7d

NODE_ENV=production
PORT=3001
API_PREFIX=/api/v1

# Local production testing defaults. Replace with https://your-domain.example
# and https://api.your-domain.example/api/v1 when deploying behind a domain.
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
BACKEND_PORT=3001
FRONTEND_PORT=3000

UPLOAD_LOCAL_PATH=/app/uploads
UPLOAD_LOCAL_URL_PREFIX=/uploads

LOG_LEVEL=info
