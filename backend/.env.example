# ───────────────────────────────────────────────
# SARVAA Fresh — Backend Environment Variables
# Copy this file to .env and fill in real values
# ───────────────────────────────────────────────

# ─── Database ──────────────────────────────────
DATABASE_URL="postgresql://sarvaa:sarvaa_dev_pass@localhost:5432/sarvaa_fresh?schema=public"

# ─── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Authentication ────────────────────────────
JWT_SECRET=change-me-to-a-256-bit-random-secret-key
JWT_EXPIRES_IN=7d

# ─── Server ────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=/api/v1

# ─── Frontend URL ──────────────────────────────
FRONTEND_URL=http://localhost:3000